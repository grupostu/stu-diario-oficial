{
  "name": "@stu/diario-oficial",
  "version": "1.0.0",
  "description": "Plataforma Inteligente de Búsqueda, Digitalización y Alertas de Diarios Oficiales de El Salvador - Grupo Stu, S.A.S. (diario.grupostu.com)",
  "main": "dist/server.js",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); fs.copyFileSync('src/data_diario_real.json', 'dist/data_diario_real.json'); fs.copyFileSync('src/diarios.json', 'dist/diarios.json');\"",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "corpus": "tsx scripts/construir_corpus.ts public/pdf/23-10-2026.pdf"
  },
  "keywords": [
    "diario-oficial",
    "el-salvador",
    "laip",
    "edictos",
    "dui",
    "alertas",
    "grupo-stu"
  ],
  "author": "Grupo Stu, S.A.S.",
  "license": "UNLICENSED",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "pdfjs-dist": "3.11.174",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
